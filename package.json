{
  "name": "nas-download-manager",
  "version": "0.13.1",
  "private": true,
  "description": "An open source browser extension for adding/managing download tasks to your Synology DiskStation.",
  "scripts": {
    "test": "cross-env TS_NODE_PROJECT=test/tsconfig-test.json mocha --require ts-node/register \"test/**/*.{ts,tsx}\"",
    "lint": "prettier --check src/**/* && tsc -p src --noemit",
    "check": "pnpm lint && pnpm test",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "package": "pnpm build && node scripts/package-extension.mjs",
    "package:sources": "node scripts/package-sources.mjs",
    "zip": "pnpm package",
    "zip-sources": "pnpm package:sources",
    "bump-version": "node scripts/bump-version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyakaspeter/nas-download-manager.git"
  },
  "homepage": "https://github.com/nyakaspeter/nas-download-manager#readme",
  "bugs": {
    "url": "https://github.com/nyakaspeter/nas-download-manager/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@types/chai": "^4.0.4",
    "@types/glob": "^5.0.33",
    "@types/lodash": "^4.14.141",
    "@types/mocha": "^2.2.44",
    "@types/node": "^14.14.41",
    "@types/react": "^17.0.34",
    "@types/react-dom": "^17.0.0",
    "archiver": "^7.0.1",
    "chai": "^4.1.2",
    "cross-env": "^10.0.0",
    "css-loader": "^6.8.1",
    "glob": "^7.1.2",
    "mini-css-extract-plugin": "^2.7.6",
    "mocha": "^4.0.1",
    "prettier": "^2.2.1",
    "sass": "^1.22.10",
    "sass-loader": "^13.3.2",
    "semver": "^7.3.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^9.1.1",
    "typescript": "^5.2.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "classnames": "^2.3.1",
    "lodash": "^4.17.21",
    "moment": "^2.18.1",
    "query-string": "^6.8.2",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-textarea-autosize": "^8.3.2",
    "webextension-polyfill": "^0.12.0"
  },
  "packageManager": "pnpm@11.19.0"
}
